# Release settings for this repo (read by the workflows; the other files are synced by dsh-plugins/_ci/sync.sh)
PKG_DIR=plugin
ASSETS=dsh-mac-computer-use.tgz dsh-cu.tgz
TEST_CMD=node tools/test-panel.mjs && swiftc -typecheck tools/dsh-cu.swift && swiftc -typecheck cursor/cursor-overlay.swift
# Platforms that must pass a real daily DSH run (space-separated: macOS Windows); other platforms are informational only
PLATFORMS=macOS Windows
# Real-machine e2e: verifies the install bundle (with its prebuilt binaries) works in a fresh DSH; skipped on non-macOS
E2E_CMD=node e2e/e2e-dsh.mjs
